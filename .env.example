NEXT_PUBLIC_SUPABASE_URL=https://api.clubrotariosdcolonial.org
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://www.clubrotariosdcolonial.org
NEXT_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:26911
SUPABASE_SERVER_URL=http://127.0.0.1:26911
# Server-only, writable by the Next service identity; never place logs in public/.
CLUB_DIAGNOSTICS_DIR=C:/ProgramData/ClubRotarioSDC/diagnostics

# Resend SMTP credential for local Supabase Auth. Store the real value only in ignored .env.
RESEND_API_KEY=

# Optional Cloudflare Turnstile (H08). Leave empty to disable. The secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.clubrotariosdcolonial.org,clubrotariosdcolonial.org
# The stack operator supplies SUPABASE_AUTH_CAPTCHA_SECRET via its protected environment.
# Enable the published nonce policy after the Report-Only browser review.
CLUB_CSP_ENFORCE=true
