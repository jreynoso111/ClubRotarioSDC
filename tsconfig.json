{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-releases/*/types/**/*.ts",
    ".next-releases/*/dev/types/**/*.ts",
    ".next-releases/20261017-024500/types/**/*.ts",
    ".next-releases/20261017-024500/dev/types/**/*.ts",
    ".next-releases/20261017-112711/types/**/*.ts",
    ".next-releases/20261017-112711/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-releases/20261017-122724/types/**/*.ts",
    ".next-releases/20261017-122724/dev/types/**/*.ts",
    ".next-releases/20261017-130529/types/**/*.ts",
    ".next-releases/20261017-130529/dev/types/**/*.ts",
    ".next-releases/20261017-145846/types/**/*.ts",
    ".next-releases/20261017-145846/dev/types/**/*.ts",
    ".next-releases/20261017-152648/types/**/*.ts",
    ".next-releases/20261017-152648/dev/types/**/*.ts",
    ".next-releases/20261017-153053/types/**/*.ts",
    ".next-releases/20261017-153053/dev/types/**/*.ts",
    ".next-releases/20261017-153335/types/**/*.ts",
    ".next-releases/20261017-153335/dev/types/**/*.ts",
    ".next-releases/20261017-153505/types/**/*.ts",
    ".next-releases/20261017-153505/dev/types/**/*.ts",
    ".next-releases/20261017-160531/types/**/*.ts",
    ".next-releases/20261017-160531/dev/types/**/*.ts",
    ".next-releases/20261017-161245/types/**/*.ts",
    ".next-releases/20261017-161245/dev/types/**/*.ts",
    ".next-releases/20261017-193652/types/**/*.ts",
    ".next-releases/20261017-193652/dev/types/**/*.ts",
    ".next-releases/20261017-194327/types/**/*.ts",
    ".next-releases/20261017-194327/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
